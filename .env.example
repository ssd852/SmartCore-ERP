# ─────────────────────────────────────────────────────────────────────────────
# SmartCore ERP — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit the real .env or .env.local files to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Your Supabase project URL (found in: Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# ⚠️  ANON KEY ONLY — Use the public "anon" key, NOT the "service_role" key.
# The service_role key bypasses ALL Row Level Security policies.
# It must NEVER appear in frontend code.
# (Found in: Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key-here...
